# Copier ce fichier vers .env pour configurer le backend en local.
APP_ENV=dev

# Remplacer cette valeur par un secret propre à chaque installation.
APP_SECRET=a-remplacer-localement

APP_SHARE_DIR=var/share
DEFAULT_URI=http://127.0.0.1:5173

# Aucun envoi réel avec ce transport. Configurer Brevo dans .env.local.
MAILER_DSN=null://null
MAILER_FROM="Le Grand Cinéma <le.grand.cinema.contact@gmail.com>"
